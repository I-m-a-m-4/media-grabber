rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Users collection: allow anonymous and authenticated users to read and write their own profile
    match /users/{userId} {
      allow read, create, update: if request.auth != null;
    }
    
    // Downloads activity log
    match /downloads/{downloadId} {
      allow read, create, update: if request.auth != null;
    }

    // Analytics summary counters
    match /analytics/{docId} {
      allow read, write: if request.auth != null;
    }

    // Payments collection: allow write when payment processed, read restricted to admin
    match /payments/{paymentId} {
      allow create: if request.auth != null;
      allow read: if request.auth != null;
    }
  }
}
